# Copia este archivo como ".env" (en la misma carpeta) y completa los valores.
# El archivo .env NO se sube a GitHub: pide los datos reales al equipo.

# Servidor (opcional, por defecto 3000)
PORT=3000

# Base de datos PostgreSQL
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Clave para firmar las sesiones (JWT): cualquier texto largo y aleatorio.
# Puedes generar una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
